{
  // Master switch for Nemesis Protocol.
  // true = enabled. false = the mod loads but does not create or spawn rivals.
  "Enabled": true,

  // Percentage chance that an eligible active nemesis is scheduled to appear in a PMC raid.
  // Valid range: 0 to 100. Example: 42.0 means a 42% chance.
  "SpawnChancePercent": 42.0,

  // Minimum number of completed PMC raids that must pass after a nemesis appearance before it can appear again.
  // 0 allows back-to-back appearances when the spawn chance succeeds. 1 guarantees at least one raid between appearances.
  "MinimumRaidsBetweenAppearances": 1,

  // Maximum number of bonus levels a nemesis may gain above its original base level.
  // With APBS installed, this becomes the requested progression target used before APBS selects the final level and gear tier.
  "MaximumBonusLevels": 16,

  // Bonus levels gained whenever the nemesis kills the player.
  "LevelGainPerPlayerKill": 2,

  // Bonus levels gained when the nemesis appears and survives the raid.
  "LevelGainPerEscape": 1,

  // Extra health applied per nemesis rank as a decimal multiplier.
  // Example: 0.08 means +8% health per rank. Set to 0.0 to disable health scaling.
  "HealthBonusPerRank": 0.08,

  // true = only replace a naturally generated PMC whose faction matches the nemesis.
  // false = either PMC faction may be used as the replacement candidate.
  "RequireMatchingFaction": true,

  // Master switch for Nemesis Network messages, including creation, kill, escape, and defeat messages.
  "SendMessages": true,

  // Controls messages sent when the nemesis survives an appearance.
  // This setting has no effect when SendMessages is false.
  "SendEscapeMessages": true,

  // Text appended to the rival's original nickname. Include a leading space when desired.
  // Use an empty string to keep the original name unchanged.
  "NameSuffix": " [NEMESIS]",

  // Optional APBS and ORBIT compatibility behavior.
  // Nemesis Protocol still functions when either mod is not installed.
  "Compatibility": {
    // true = when APBS is detected, Nemesis supplies its requested progression level before APBS creates the final level, tier, and inventory.
    // false = Nemesis does not deliberately pass its progression target into APBS.
    "UseApbsProgression": true,

    // true = preserves the rival as a normal USEC/BEAR PMC so ORBIT and other PMC AI mods retain control of behavior.
    // Keep this enabled for the current release.
    "PreserveOrbitPmcRole": true,

    // true = when APBS is absent, Nemesis requests its progression level through the standard SPT bot-generation path.
    // false = normal SPT level generation remains authoritative when APBS is absent.
    "ExactLevelFallbackWithoutApbs": true,

    // true = prints APBS/ORBIT detection and authority information in the SPT server console at startup.
    "LogDetection": true
  },

  // Internal SPT map IDs where Nemesis Protocol is disabled.
  // Add or remove entries as desired. The defaults prevent rivalry logic in the Hideout and development/test location.
  "DisabledMaps": [
    "hideout",
    "develop"
  ],

  // Random message pool used when a PMC first becomes the player's active nemesis.
  // Add, remove, or rewrite strings. Keep quotation marks and commas valid.
  "CreationMessages": [
    "You know my name now. I know yours too.",
    "That death was an introduction. The next one will be personal.",
    "You should have stayed out of my sector. I'll be seeing you again."
  ],

  // Random message pool used after the nemesis kills the player again.
  "KillMessages": [
    "Again. You're making this easy.",
    "I told you this wasn't over.",
    "Another tag for the collection. Gear up. Come find me."
  ],

  // Random message pool used when the nemesis was present but survived the raid.
  // These messages require both SendMessages and SendEscapeMessages to be true.
  "EscapeMessages": [
    "You were close. Close doesn't count.",
    "I walked out. Did you really think that was the end?",
    "Same map, same mistake. Next time one of us stays behind."
  ],

  // Random message pool used when the player kills and defeats the active nemesis.
  "DeathMessages": [
    "Debt paid. Don't expect the next hunter to be as careless.",
    "You finally got me. Keep the tag.",
    "So that's how it ends. Enjoy the silence while it lasts."
  ]
}
